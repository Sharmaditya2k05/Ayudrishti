{
  "id": "balasana",
  "name": "Balasana",
  "english_name": "Child's Pose",
  "difficulty": "beginner",
  "symmetry": "bilateral",
  "hold_seconds": 45,
  "description": "A kneeling rest. The hips settle back toward the heels, the torso folds forward over the thighs, and the forehead releases toward the floor. The standard recovery posture between more demanding asanas. Best assessed from a side view.",
  "preferred_view": "side",
  "camera_hint": "Place your camera to your side, about 2-3 metres away, so your whole body is in frame from the side.",
  "image_url": "https://commons.wikimedia.org/wiki/Special:FilePath/Balasana%20zamkovoi.jpg?width=600",
  "image_credit": "Photo: Sezam777 / Wikimedia Commons, CC BY-SA 4.0",
  "target_goals": [
    "relaxation",
    "stress_reduction",
    "flexibility",
    "beginner_learning"
  ],
  "focus_areas": [
    "hips",
    "lower_back",
    "relaxation"
  ],
  "corrects": [
    "recovery",
    "hip_flexibility"
  ],
  "preparatory": [],
  "benefits": [
    "Releases the lower back and hips",
    "Slows the breath and settles the nervous system",
    "Serves as a safe rest position at any point in a session"
  ],
  "contraindications": [
    "Knee injury",
    "Pregnancy (take knees wide)",
    "Recent ankle injury"
  ],
  "cues": [
    "Kneel and bring your hips back toward your heels",
    "Fold your torso forward over your thighs",
    "Rest your forehead toward the floor",
    "Let your arms extend forward or rest alongside your body",
    "Breathe slowly into the back of your ribs"
  ],
  "components": {
    "legs": "Knee fold",
    "torso": "Forward fold",
    "arms": "Arms"
  },
