{
  "id": "utkatasana",
  "name": "Utkatasana",
  "english_name": "Chair Pose",
  "difficulty": "beginner",
  "symmetry": "bilateral",
  "hold_seconds": 25,
  "description": "A standing squat. The knees bend and the hips sit back as if toward a chair, the chest stays lifted, and the arms reach up alongside the ears.",
  "preferred_view": "side",
  "camera_hint": "Place your camera to your side, about 2-3 metres away, so your whole body is in frame from the side.",
  "image_url": "https://commons.wikimedia.org/wiki/Special:FilePath/Utkatasana%20Yoga-Asana%20Nina-Mel.jpg?width=600",
  "image_credit": "Photo: Kennguru / Wikimedia Commons, CC BY 3.0",
  "target_goals": [
    "strength",
    "general_fitness",
    "beginner_learning"
  ],
  "focus_areas": [
    "thighs",
    "core",
    "shoulders",
    "ankles"
  ],
  "corrects": [
    "knee_alignment",
    "torso_alignment"
  ],
  "preparatory": [
    "tadasana"
  ],
  "benefits": [
    "Strengthens the thighs, hips and ankles",
    "Builds core and shoulder endurance",
    "Prepares the legs for standing balance poses"
  ],
  "contraindications": [
    "Knee injury",
    "Low blood pressure",
    "Shoulder injury (keep arms lower)"
  ],
  "cues": [
    "Bend your knees and sit your hips back and down",
    "Keep your weight in your heels so you can still see your toes",
    "Lift your chest rather than folding forward",
    "Reach your arms up alongside your ears",
    "Keep your knees pointing forward, in line with your feet"
  ],
  "components": {
    "legs": "Legs",
    "torso": "Torso",
    "arms": "Arms"
  },
  "rules": [
    {
      "id": "left_knee_bent",
      "component": "legs",
      "body_part": "left knee",
      "measurement": "angle",
      "landmarks": [
        "left_hip",
        "left_knee",
        "left_ankle"
      ],
      "target": [
        95,
        140
      ],
      "tolerance": 35,
      "weight": 2.5,
      "feedback": {
        "low": "You are squatting very deeply. Rise slightly to protect your knees.",
        "high": "Bend your knees more and sit your hips lower."
      }
    },
    {
      "id": "right_knee_bent",
      "component": "legs",
      "body_part": "right knee",
      "measurement": "angle",
      "landmarks": [
        "right_hip",
