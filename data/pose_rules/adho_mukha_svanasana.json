{
  "id": "adho_mukha_svanasana",
  "name": "Adho Mukha Svanasana",
  "english_name": "Downward-Facing Dog",
  "difficulty": "intermediate",
  "symmetry": "bilateral",
  "hold_seconds": 30,
  "description": "An inverted V. Hands and feet press into the floor while the hips lift high, the arms and back form one long line, and the legs work toward straight without rounding the spine. Best assessed from a side view.",
  "preferred_view": "side",
  "camera_hint": "Place your camera to your side, about 2-3 metres away, so your whole body is in frame from the side.",
  "image_url": "https://commons.wikimedia.org/wiki/Special:FilePath/Adho%20mukha%20svanasana%20zamkovoi.jpg?width=600",
  "image_credit": "Photo: Sezam777 / Wikimedia Commons, CC BY-SA 4.0",
  "target_goals": [
    "flexibility",
    "strength",
    "mobility",
    "general_fitness"
  ],
  "focus_areas": [
    "hamstrings",
    "shoulders",
    "spine",
    "calves"
  ],
  "corrects": [
    "spine_extension",
    "shoulder_alignment",
    "hamstring_flexibility"
  ],
  "preparatory": [
    "balasana",
    "bhujangasana"
  ],
  "benefits": [
    "Lengthens the hamstrings, calves and spine",
    "Builds shoulder and arm strength",
    "Calms the nervous system as a mild inversion"
  ],
  "contraindications": [
    "Wrist injury",
    "Late pregnancy",
    "Uncontrolled high blood pressure",
    "Recent eye surgery"
  ],
  "cues": [
    "Press your hands firmly into the floor and lift your hips high",
    "Reach your hips up and back to make one long line from wrists to hips",
    "Let your knees bend slightly if your lower back rounds",
    "Draw your shoulders away from your ears",
    "Let your head hang freely between your arms"
  ],
  "components": {
    "hips": "Hip position",
    "spine": "Spine line",
    "arms": "Arms",
    "legs": "Legs"
  },
  "rules": [
    {
      "id": "hip_angle_v_shape",
      "component": "hips",
      "body_part": "hips",
      "measurement": "angle",
      "landmarks": [
        "left_shoulder",
        "left_hip",
        "left_knee"
      ],
      "target": [
        62,
        105
      ],
      "tolerance": 35,
      "weight": 2.5,
      "feedback": {
        "low": "Your hips are folded very deeply. Ease the fold slightly and lengthen your spine.",
        "high": "Lift your hips higher and press them back to deepen the V shape."
      }
    },
    {
      "id": "hips_highest_point",
      "component": "hips",
      "body_part": "hips",
