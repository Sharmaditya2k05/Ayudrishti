      "component": "legs",
      "body_part": "left knee",
      "measurement": "angle",
      "landmarks": [
        "left_hip",
        "left_knee",
        "left_ankle"
      ],
      "target": [
        168,
        180
      ],
      "tolerance": 25,
      "weight": 1.5,
      "feedback": {
        "low": "Straighten your left leg without locking the knee.",
        "high": ""
      }
    },
    {
