{
  "id": "tadasana",
  "name": "Tadasana",
  "english_name": "Mountain Pose",
  "difficulty": "beginner",
  "symmetry": "bilateral",
  "hold_seconds": 30,
  "description": "The foundational standing posture. Feet grounded, spine tall, shoulders relaxed, arms resting alongside the body. Every other standing asana is built on the alignment learned here.",
  "preferred_view": "front",
  "camera_hint": "Place your camera facing you, about 2-3 metres away, so your whole body is in frame.",
  "image_url": "https://commons.wikimedia.org/wiki/Special:FilePath/Tadasana%20Yoga-Asana%20Nina-Mel.jpg?width=600",
  "image_credit": "Photo: Kennguru / Wikimedia Commons, CC BY 3.0",
  "target_goals": [
    "beginner_learning",
    "general_fitness",
    "relaxation",
    "mobility"
  ],
  "focus_areas": [
    "posture",
    "core",
    "shoulders",
    "legs"
  ],
  "corrects": [
    "torso_alignment",
    "shoulder_alignment"
  ],
  "preparatory": [],
  "benefits": [
    "Builds postural awareness and steadiness",
    "Teaches even weight distribution through both feet",
    "Gently strengthens thighs, knees and ankles"
  ],
  "contraindications": [
    "Low blood pressure with dizziness on standing"
  ],
  "cues": [
    "Stand with your feet close together and weight even across both feet",
    "Lengthen upward through the crown of your head",
    "Let your shoulders drop away from your ears",
    "Keep your arms relaxed alongside your body, palms facing forward"
  ],
  "components": {
    "legs": "Legs",
    "torso": "Torso",
    "shoulders": "Shoulders",
    "arms": "Arms"
  },
  "rules": [
