{
  "id": "paschimottanasana",
  "name": "Paschimottanasana",
  "english_name": "Seated Forward Bend",
  "difficulty": "intermediate",
  "symmetry": "bilateral",
  "hold_seconds": 40,
  "description": "A seated forward fold. Sitting with the legs extended, the torso hinges forward from the hips over straight legs while the spine stays long rather than rounding. Best assessed from a side view.",
  "preferred_view": "side",
  "camera_hint": "Place your camera to your side, about 2-3 metres away, so your whole body is in frame from the side.",
  "image_url": "https://commons.wikimedia.org/wiki/Special:FilePath/Paschimotanasana%20Yoga-Asana%20Nina-Mel.jpg?width=600",
  "image_credit": "Photo: Kennguru / Wikimedia Commons, CC BY 3.0",
  "target_goals": [
    "flexibility",
    "relaxation",
    "stress_reduction",
    "mobility"
  ],
  "focus_areas": [
    "hamstrings",
    "lower_back",
    "spine"
  ],
  "corrects": [
    "hamstring_flexibility",
    "spine_extension"
  ],
  "preparatory": [
    "balasana",
    "adho_mukha_svanasana"
  ],
  "benefits": [
    "Lengthens the hamstrings and the whole back line of the body",
    "Encourages a calm, inward focus",
    "Relieves tension along the spine"
  ],
  "contraindications": [
    "Herniated disc",
    "Recent back injury",
    "Pregnancy"
  ],
  "cues": [
    "Sit tall with your legs extended and feet flexed",
    "Hinge forward from your hips, not your waist",
    "Lead with your chest to keep the spine long",
    "Bend your knees slightly if your back rounds",
    "Reach your hands toward your shins, ankles or feet"
  ],
  "components": {
    "legs": "Legs",
    "torso": "Forward fold",
    "spine": "Spine length",
    "arms": "Arms"
  },
  "rules": [
    {
      "id": "left_leg_straight",
      "component": "legs",
      "body_part": "left knee",
      "measurement": "angle",
      "landmarks": [
        "left_hip",
        "left_knee",
        "left_ankle"
      ],
      "target": [
        158,
        180
      ],
      "tolerance": 32,
      "weight": 2.5,
      "feedback": {
        "low": "Work toward straightening your legs, keeping only a small bend if your hamstrings are tight.",
        "high": ""
      }
    },
    {
      "id": "right_leg_straight",
      "component": "legs",
      "body_part": "right knee",
