# Where the "Start Your Session" button and app nav links point.
#
# Defaults to Expo's web dev-server port when unset. In production, set this
# to wherever the AyuDrishti app is hosted.
#
#   local dev (Expo web):   http://localhost:8081
#   production:             https://app.ayudrishti.example
VITE_APP_URL=http://localhost:8081
