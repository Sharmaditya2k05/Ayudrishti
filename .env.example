# AyuDrishti backend configuration.
# Copy to .env and adjust. Never commit the real .env.

# ---- Database ------------------------------------------------------------
# PostgreSQL is the target database.
DATABASE_URL=postgresql+psycopg2://ayudrishti:changeme@localhost:5432/ayudrishti
#
# A SQLite fallback is used automatically when DATABASE_URL is unset, so the
# test suite and a first-run demo work without a server. It is for local
# development only -- the app logs a warning whenever it is active.
# DATABASE_URL=sqlite:///./data/ayudrishti.db

DB_ECHO=false

# ---- Authentication ------------------------------------------------------
# REQUIRED in production. Without it a random key is generated per process,
# which invalidates every issued token on restart.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS ----------------------------------------------------------------
# Comma-separated. Restrict this to your app's origins in production.
CORS_ORIGINS=*

# ---- Pose pipeline -------------------------------------------------------
# Optional: path to a MediaPipe .task bundle for server-side detection.
# Not needed when the mobile client sends landmarks, which is the default.
POSE_MODEL_PATH=
VISIBILITY_THRESHOLD=0.5

# ---- Privacy -------------------------------------------------------------
# Both default to false by design. AyuDrishti stores derived metrics, not
# imagery. Enabling either changes the product's privacy posture -- do not
# turn them on without a documented reason and user consent.
STORE_RAW_FRAMES=false
RETAIN_LANDMARKS=false

# ---- Yoga assistant (RAG over Groq) ---------------------------------------
# Optional. The /assistant/ask endpoint retrieves relevant asana data and
# curated yoga knowledge (data/knowledge/) for a question, then asks a Groq
# model to answer grounded in that context. Leave GROQ_API_KEY empty to
# leave the assistant disabled -- the endpoint reports itself unconfigured
# rather than failing.
# Get a free key at https://console.groq.com/keys
# Groq rotates which models it serves -- see the current list at
# https://console.groq.com/docs/models (or `GET /openai/v1/models` with your
# key). If GROQ_MODEL names a retired model the assistant returns a 502.
GROQ_API_KEY=
# gpt-oss-120b gives the best answers; swap to openai/gpt-oss-20b for lower
# latency if you prefer speed over depth.
GROQ_MODEL=openai/gpt-oss-120b

DEBUG=false
